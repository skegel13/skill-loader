#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

if ! command -v python3 >/dev/null 2>&1; then
    printf 'bin/sync-repos requires Python 3.11+ (python3 was not found).\n' >&2
    exit 1
fi

if ! python_version=$(python3 -c 'import sys; print(".".join(map(str, sys.version_info[:3])))'); then
    printf 'bin/sync-repos could not determine the Python version.\n' >&2
    exit 1
fi
if [[ ! "$python_version" =~ ^([0-9]+)\.([0-9]+)\. ]] \
    || (( BASH_REMATCH[1] < 3 || (BASH_REMATCH[1] == 3 && BASH_REMATCH[2] < 11) )); then
    printf 'bin/sync-repos requires Python 3.11+ (found Python %s).\n' "$python_version" >&2
    exit 1
fi

cd "$project_dir"
exec python3 -m skill_loader.sync_repos "$@"
